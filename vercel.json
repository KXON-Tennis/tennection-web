{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tennection.kxon.net"
        }
      ],
      "destination": "https://tennisnut.kxon.net/$1",
      "permanent": true
    },
    {
      "source": "/whats-new",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/whats-new/:build",
      "destination": "/blog/:build",
      "permanent": true
    }
  ]
}
