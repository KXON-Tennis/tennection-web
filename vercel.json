{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tennection.kxon.net"
        }
      ],
      "destination": "https://tennisnut.kxon.net/$1",
      "permanent": true
    },
    {
      "source": "/whats-new",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/whats-new/:build",
      "destination": "/blog/:build",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/shop"
    },
    {
      "source": "/courts/tw",
      "destination": "/api/courts-region"
    },
    {
      "source": "/courts/tw/:city",
      "destination": "/api/courts-region?city=:city"
    },
    {
      "source": "/courts/:id",
      "destination": "/api/court?id=:id"
    },
    {
      "source": "/sitemap-courts.xml",
      "destination": "/api/sitemap-courts"
    }
  ]
}
